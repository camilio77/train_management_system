<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="co.edu.upb.train_management_system.view.ServerView">
  <grid id="27dc6" binding="mainPanel" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="10" left="10" bottom="10" right="10"/>
    <constraints>
      <xy x="32" y="45" width="600" height="334"/>
    </constraints>
    <properties>
      <minimumSize width="600" height="200"/>
      <preferredSize width="600" height="200"/>
    </properties>
    <border type="none"/>
    <children>
      <grid id="fa823" layout-manager="GridLayoutManager" row-count="2" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="8">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>

          <!-- Panel de botones: ocupa 40% del alto -->
          <grid id="2d684" binding="panelButton" layout-manager="GridBagLayout">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="1" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="785b0" class="javax.swing.JButton" binding="button">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                  <!-- weightx=0.5 hace que ambos botones compartan el ancho por igual -->
                  <gridbag weightx="0.5" weighty="0.0" insetTop="5" insetBottom="5" insetLeft="10" insetRight="5"/>
                </constraints>
                <properties>
                  <text value="Start Server"/>
                </properties>
              </component>
              <component id="60abc" class="javax.swing.JButton" binding="stopButton">
                <constraints>
                  <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                  <gridbag weightx="0.5" weighty="0.0" insetTop="5" insetBottom="5" insetLeft="5" insetRight="10"/>
                </constraints>
                <properties>
                  <text value="Stop Server"/>
                </properties>
              </component>
            </children>
          </grid>

          <!-- Panel de consola: ocupa 60% del alto y el label se estira -->
          <grid id="44054" binding="panelConsole" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
            <margin top="5" left="10" bottom="5" right="10"/>
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <border type="etched"/>
            </properties>
            <border type="etched"/>
            <children>
              <component id="1f906" class="javax.swing.JLabel" binding="console">
                <constraints>
                  <!-- fill="3" = both: se estira horizontal y verticalmente -->
                  <!-- hsize-policy="6" = el label crece y se encoge horizontalmente -->
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="6" hsize-policy="6" anchor="8" fill="3" indent="5" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Status: Stopped."/>
                  <verticalAlignment value="1"/>
                </properties>
              </component>
            </children>
          </grid>

        </children>
      </grid>
    </children>
  </grid>
</form>